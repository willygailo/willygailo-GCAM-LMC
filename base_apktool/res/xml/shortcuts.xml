    </shortcut>
    <shortcut android:icon="@drawable/hsl_patcher" android:enabled="true" android:shortcutId="opensetting" android:shortcutShortLabel="@string/shortcut_opensett_short_label" android:shortcutLongLabel="@string/shortcut_opensett_long_label">
