<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <!-- Hardware & Base Settings for Tecno & Infinix -->
    <string name="pref_device_key">0</string>
    <string name="pref_device_key_front">0</string>
    <string name="pref_rn8p_key">1</string>
    <string name="pref_samsungfix_key">-1</string>

    <!-- Apple iPhone 17 Pro Natural AWB & Accurate Color Science -->
    <string name="pref_awb_key">1</string>
    <string name="pref_awb_key_front">1</string>
    <string name="lib_wbbaseframe_key">1</string>

    <!-- 100% Lossless JPEG Pipeline (iPhone High-Efficiency/JPEG Quality) -->
    <string name="pref_qjpg_key">100</string>
    <string name="lib_hardjpgquality_key">15008052</string>
    <string name="lib_hardjpgquality_key_front">15008052</string>

    <!-- iPhone 17 Photonic Engine HDR (Balanced Highlights & Deep Contrast) -->
    <string name="pref_frames_hdr_key">18</string>
    <string name="pref_frames_hdr_key_front">15</string>

    <!-- iPhone 17 ISP Patcher: Apple Micro-Contrast, Zero Noise, Clean Edge Definition -->
    <string name="pref_enable_patcher_key">1</string>
    <string name="lib_shastaforce_key">1</string>
    <string name="lib_shastafactor_key">1</string>
    <string name="lib_withtetmismatch_key">1</string>
    <string name="lib_sharpness_key">1.125</string>
    <string name="lib_saturation_key">1.0625</string>
    <string name="lib_contrast_key">1.1875</string>
    <string name="lib_shadows_key">0.9375</string>

    <!-- Viewfinder HUD Controls -->
    <string name="pref_show_button_leica">0</string>
    <string name="pref_show_button_awb">1</string>
    <string name="pref_show_button_pro">1</string>
    <string name="pref_show_button_expslide">1</string>
    <string name="pref_show_button_ois">1</string>
    <string name="pref_show_button_af">1</string>

    <!-- Video Bitrate & Stabilization -->
    <string name="pref_bitrate_key">15</string>
    <boolean name="pref_video_stabilization_key" value="true" />
</map>
