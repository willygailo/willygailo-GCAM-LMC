    <string name="pref_device_key">0</string>
    <string name="pref_device_key_front">0</string>
    <string name="pref_rn8p_key">1</string>
    <string name="pref_samsungfix_key">-1</string>

    <!-- Apple ProRes / Cinematic Video Tone Science -->
    <string name="pref_awb_key">1</string>
    <string name="pref_awb_key_front">1</string>
    <string name="lib_wbbaseframe_key">1</string>

    <!-- Maximum Studio Video Bitrate (ProRes Bitrate Allocation) -->
    <string name="pref_bitrate_key">15</string>

